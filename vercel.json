{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/rumah-tangga",
      "dest": "/rumahtangga.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}